{
  "name": "dsh-workspace-sort",
  "version": "1.0.0",
  "description": "Sort DSH sidebar conversations by recency and order workspace groups by their newest conversation; the per-workspace visible conversation count is configurable in Settings.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "workspace",
    "sidebar",
    "session",
    "sort"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "LostAbaddon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LostAbaddon/dsh-workspace-sort.git"
  },
  "homepage": "https://github.com/LostAbaddon/dsh-workspace-sort",
  "bugs": {
    "url": "https://github.com/LostAbaddon/dsh-workspace-sort/issues"
  }
}
