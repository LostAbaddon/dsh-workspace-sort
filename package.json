{
  "name": "dsh-workspace-sort",
  "version": "1.1.0",
  "description": "Shape the DSH sidebar and the LLM network path: order workspaces by their newest conversation, fold visible conversation counts, remember a model per workspace, edit a past user message in place, and route each LLM provider through a proxy or straight out.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test test/core.test.mjs test/conversation-edit.test.mjs test/proxy-core.test.mjs test/proxy-host.test.mjs test/proxy-routing.test.mjs test/proxy-page.test.mjs",
    "test:cordis": "node test/cordis/run.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web",
      "immediately": true
    },
    "manifestVersion": 1
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "workspace",
    "sidebar",
    "session",
    "sort",
    "proxy",
    "llm",
    "network"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "LostAbaddon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LostAbaddon/dsh-workspace-sort.git"
  },
  "homepage": "https://github.com/LostAbaddon/dsh-workspace-sort",
  "bugs": {
    "url": "https://github.com/LostAbaddon/dsh-workspace-sort/issues"
  }
}
